<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 阿里云号码认证 SDK 授权页使用的第三方/内部域名允许明文(与官方 Demo 同款配置,SDK 内部请求需要) -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链①:自定义 scheme lmhchat://invite/<id>(与 iOS 同款) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lmhchat" />
            </intent-filter>

            <!-- 深链②:官方网页链接 https://chat.linminhao.top/i/<id> 或 /t/<id>
                 autoVerify=false:诚实标注未做 /.well-known/assetlinks.json 域名校验,
                 故系统会弹「用哪个应用打开」选择框(而非静默直达),功能不受影响。 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="chat.linminhao.top" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="chat.linminhao.top" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="linminhao.top" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="linminhao.top" android:pathPrefix="/t/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 阿里云号码认证(一键登录):SDK 授权页。
             主题 @style/authsdk_activity_dialog 由 aar 自带;screenOrientation 必须 "behind"(官方要求,
             窗口模式指定明确方向在 Android 8 会 crash);launchMode singleTop 防重复唤起。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|fontScale"
            android:exported="false"
            android:launchMode="singleTop"
            android:name="com.mobile.auth.gatewayauth.LoginAuthActivity"
            android:screenOrientation="behind"
            android:theme="@style/authsdk_activity_dialog" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 语音消息录制(VoiceRecorderPlugin) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 号码认证:SDK 检测 SIM/运营商(官方标注为可选权限;声明后更稳,Play 商店会标注) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
</manifest>
